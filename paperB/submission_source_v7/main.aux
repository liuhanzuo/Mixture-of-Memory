\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {All held-out perplexity checkpoints used in this study.} Every point uses the same disjoint $4096\times 2048$ Dolmino validation shard ($8{,}384{,}512$ target tokens) and token-weighted eight-shard merging. The frozen-front arm retains the same pretrained prefix but does not update it; the fully random-init arm has the same $16$-layer shape but loads no pretrained weights. ShortGPT inherits non-contiguous layers $[0\text  {--}12,16,17,31]$ and appends no fresh blocks. $^{\dagger }$The available endpoint values come from the retained keep8 at 121k, keep10 at 83.5k, and keep12 at 124k checkpoints after metric-based stopping; no literal step-200k evaluation is available for these arms, and PPL was still decreasing. $^{\ddagger }$All reported full32 results use its available step-25k checkpoint; it is not a long-horizon matched counterfactual.}}{11}{table.caption.20}\protected@file@percent }
\newlabel{tab:app-ppl}{{3}{11}{\textbf {All held-out perplexity checkpoints used in this study.} Every point uses the same disjoint $4096\times 2048$ Dolmino validation shard ($8{,}384{,}512$ target tokens) and token-weighted eight-shard merging. The frozen-front arm retains the same pretrained prefix but does not update it; the fully random-init arm has the same $16$-layer shape but loads no pretrained weights. ShortGPT inherits non-contiguous layers $[0\text {--}12,16,17,31]$ and appends no fresh blocks. $^{\dagger }$The available endpoint values come from the retained keep8 at 121k, keep10 at 83.5k, and keep12 at 124k checkpoints after metric-based stopping; no literal step-200k evaluation is available for these arms, and PPL was still decreasing. $^{\ddagger }$All reported full32 results use its available step-25k checkpoint; it is not a long-horizon matched counterfactual}{table.caption.20}{}}
