\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Non-contiguous ShortGPT endpoint.} For block $i$, selection uses $\mathrm  {BI}_i=1-\mathbb  {E}_{x,t}\cos (h^{(i)}_{\mathrm  {in}}, h^{(i)}_{\mathrm  {out}})$ over 128 evenly spaced Dolmino windows ($262{,}144$ tokens), retaining the 16 highest-BI blocks $[0\text  {--}12,16,17,31]$. No evaluation task is used for selection and no fresh tail is appended. \texttt  {core6} is the unweighted macro-average of HellaSwag, ARC-Challenge, ARC-Easy, PIQA, and OpenBookQA character-normalized accuracy plus WinoGrande raw accuracy. The unhealed construction is initially degenerate; the 200k endpoint is one run and is not a selection-only ablation.}}{12}{table.caption.21}\protected@file@percent }
\newlabel{tab:app-shortgpt}{{4}{12}{\textbf {Non-contiguous ShortGPT endpoint.} For block $i$, selection uses $\mathrm {BI}_i=1-\mathbb {E}_{x,t}\cos (h^{(i)}_{\mathrm {in}}, h^{(i)}_{\mathrm {out}})$ over 128 evenly spaced Dolmino windows ($262{,}144$ tokens), retaining the 16 highest-BI blocks $[0\text {--}12,16,17,31]$. No evaluation task is used for selection and no fresh tail is appended. \texttt {core6} is the unweighted macro-average of HellaSwag, ARC-Challenge, ARC-Easy, PIQA, and OpenBookQA character-normalized accuracy plus WinoGrande raw accuracy. The unhealed construction is initially degenerate; the 200k endpoint is one run and is not a selection-only ablation}{table.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Complete 11-task keep8 downstream trajectory.} The final column is the accuracy-point change from $44$k to the retained $121$k endpoint checkpoint under the reported metric shown in column two; ``norm.'' denotes accuracy based on character-normalized candidate log-likelihood. MMLU remains near chance while most other tasks improve. Earlier PPL checkpoints use a separate grid; the final held-out PPL is reported at 121k in Table~\ref {tab:app-ppl}. This table reports aggregate checkpoints, not a paired 44k--121k test or a replicated trajectory.}}{12}{table.caption.22}\protected@file@percent }
\newlabel{tab:app-keep8}{{5}{12}{\textbf {Complete 11-task keep8 downstream trajectory.} The final column is the accuracy-point change from $44$k to the retained $121$k endpoint checkpoint under the reported metric shown in column two; ``norm.'' denotes accuracy based on character-normalized candidate log-likelihood. MMLU remains near chance while most other tasks improve. Earlier PPL checkpoints use a separate grid; the final held-out PPL is reported at 121k in Table~\ref {tab:app-ppl}. This table reports aggregate checkpoints, not a paired 44k--121k test or a replicated trajectory}{table.caption.22}{}}
