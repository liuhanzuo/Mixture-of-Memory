\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Proxy-validity view of the observed paths.} \textbf  {Left:} the single keep14 run improves on both measured axes from 128k to 200k steps, while answer-letter MMLU remains far below the intact base. \textbf  {Right:} endpoint and null operating points make three boundaries visible: random initialization has an answer-letter chance score but a high content-score floor; ShortGPT reaches a stronger endpoint under a coupled construction; and full32 ends at 25k, not 200k. PPL is evaluated on a same-source held-out Dolmino shard. Each trained construction is one run; token counts are nominal presentations. The figure supports proxy insufficiency of improvement alone on these literal paths, not a prospective threshold test or a causal, localization, deletion, or universal-dynamics claim.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:proxy-validity}{{1}{2}{\textbf {Proxy-validity view of the observed paths.} \textbf {Left:} the single keep14 run improves on both measured axes from 128k to 200k steps, while answer-letter MMLU remains far below the intact base. \textbf {Right:} endpoint and null operating points make three boundaries visible: random initialization has an answer-letter chance score but a high content-score floor; ShortGPT reaches a stronger endpoint under a coupled construction; and full32 ends at 25k, not 200k. PPL is evaluated on a same-source held-out Dolmino shard. Each trained construction is one run; token counts are nominal presentations. The figure supports proxy insufficiency of improvement alone on these literal paths, not a prospective threshold test or a causal, localization, deletion, or universal-dynamics claim}{figure.caption.1}{}}
