\def\@LN@column{2}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Equal-latency quality is selector-dependent; CoMem does not win either aggregate.} The latency-only calibration freezes replay budget 10 against CoMem budget 12 within a predeclared $\pm 5\%$ band. Quality is the equal-weight mean of nine task--length cells ($n{=}100$ each), and $\Delta $ is CoMem minus replay. ``Hier.'' first resamples nine cells with replacement and then resamples the 100 paired examples within each selected cell (100,000 replicates, deterministic seeds). LOCO drops one cell and averages the other eight. The original pooled-IID intervals remain only as sensitivity: $[-14.44,-8.67]$ (BM25) and $[-4.67,2.67]$ (BGE). The first 100 LoCoMo items are all conversation 0, so conversation-cluster resampling is not identifiable. Appendix Table~\ref {tab:equal-latency-protocol} gives protocol, per-cell differences, and the fixed-cell stratified bootstrap.}}{6}{table.caption.18}\protected@file@percent }
\newlabel{tab:equal-latency}{{4}{6}{\textbf {Equal-latency quality is selector-dependent; CoMem does not win either aggregate.} The latency-only calibration freezes replay budget 10 against CoMem budget 12 within a predeclared $\pm 5\%$ band. Quality is the equal-weight mean of nine task--length cells ($n{=}100$ each), and $\Delta $ is CoMem minus replay. ``Hier.'' first resamples nine cells with replacement and then resamples the 100 paired examples within each selected cell (100,000 replicates, deterministic seeds). LOCO drops one cell and averages the other eight. The original pooled-IID intervals remain only as sensitivity: $[-14.44,-8.67]$ (BM25) and $[-4.67,2.67]$ (BGE). The first 100 LoCoMo items are all conversation 0, so conversation-cluster resampling is not identifiable. Appendix Table~\ref {tab:equal-latency-protocol} gives protocol, per-cell differences, and the fixed-cell stratified bootstrap}{table.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Bounded context-scope $\times $ Read-position diagnosis.} Paired Qwen3-8B multikey macro over 8k/16k ($n{=}200$), with identical retrieval, LoRA, and upper-layer Read. Document context adds 7.5 points with local Read positions and 12.0 with document-origin positions; changing position alone lowers the chunk-local writer by 4.5 points. The $+4.5$ interaction means the factors are not additive. This attribution is limited to the displayed cohort.}}{6}{table.caption.19}\protected@file@percent }
\newlabel{tab:context-position}{{5}{6}{\textbf {Bounded context-scope $\times $ Read-position diagnosis.} Paired Qwen3-8B multikey macro over 8k/16k ($n{=}200$), with identical retrieval, LoRA, and upper-layer Read. Document context adds 7.5 points with local Read positions and 12.0 with document-origin positions; changing position alone lowers the chunk-local writer by 4.5 points. The $+4.5$ interaction means the factors are not additive. This attribution is limited to the displayed cohort}{table.caption.19}{}}
\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Lower-layer context is a focused repair, not a new headline result.} Paired Qwen3-8B results on RULER \texttt  {niah\_multikey\_1} at 8k and 16k ($n{=}200$ pooled). Every overlap width significantly exceeds the chunk-local writer; for $w{=}32$, the gain is $+6.0$ points, 95\% CI $[3.0,9.5]$. Persistent storage and Read/decode are identical across deployable rows. FLOPs are theoretical lower-12 Write ratios; measured wall-clock overhead is larger because of chunk-level execution. No natural-task overlap result is claimed.}}{7}{table.caption.20}\protected@file@percent }
\newlabel{tab:write-context}{{6}{7}{\textbf {Lower-layer context is a focused repair, not a new headline result.} Paired Qwen3-8B results on RULER \texttt {niah\_multikey\_1} at 8k and 16k ($n{=}200$ pooled). Every overlap width significantly exceeds the chunk-local writer; for $w{=}32$, the gain is $+6.0$ points, 95\% CI $[3.0,9.5]$. Persistent storage and Read/decode are identical across deployable rows. FLOPs are theoretical lower-12 Write ratios; measured wall-clock overhead is larger because of chunk-level execution. No natural-task overlap result is claimed}{table.caption.20}{}}
