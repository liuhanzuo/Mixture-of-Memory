\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces Full chat-template-free RULER comparison using official \texttt  {string\_match\_all} ($n{=}100$ per cell). KV-Direct places the full context in the read with native RoPE and no YaRN; its 64k/128k cells are unextended stress references rather than a length-extended upper bound. CoMem keeps a bounded retrieved pack. This is \textbf  {Cohort A}: every method uses \texttt  {niah\_single\_2}, \texttt  {niah\_multikey\_1}, and \texttt  {variable\_tracking}, with $n{=}100$ and the official scorer. Its CoMem macro is 97.05. Cohort B instead uses \texttt  {niah\_single\_3} to match the YaRN arm (Table~\ref {tab:scaling}) and yields 96.07; the cohorts are never pooled in a direct comparison. $^{\dagger }$MemoryLLM is the principal external persistent-memory reference and uses its released Llama-3-8B-chat checkpoint; its different backbone precludes matched attribution.}}{16}{table.caption.41}\protected@file@percent }
\newlabel{tab:h2h}{{19}{16}{Full chat-template-free RULER comparison using official \texttt {string\_match\_all} ($n{=}100$ per cell). KV-Direct places the full context in the read with native RoPE and no YaRN; its 64k/128k cells are unextended stress references rather than a length-extended upper bound. CoMem keeps a bounded retrieved pack. This is \textbf {Cohort A}: every method uses \texttt {niah\_single\_2}, \texttt {niah\_multikey\_1}, and \texttt {variable\_tracking}, with $n{=}100$ and the official scorer. Its CoMem macro is 97.05. Cohort B instead uses \texttt {niah\_single\_3} to match the YaRN arm (Table~\ref {tab:scaling}) and yields 96.07; the cohorts are never pooled in a direct comparison. $^{\dagger }$MemoryLLM is the principal external persistent-memory reference and uses its released Llama-3-8B-chat checkpoint; its different backbone precludes matched attribution}{table.caption.41}{}}
\def\@LN@column{2}
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces LongEval register-content accuracy. Unmarked rows use the unified chat-template-free protocol. Means use the common 8k--128k support. KV-Direct uses native RoPE without YaRN, so its 64k/128k cells are unextended stress references and the five-length mean is not a length-extended upper bound. CoMem's separate six-length headline is 72.83 after including its 4k score of 92. The frozen CoMem control used 48 generation tokens rather than 16; both budgets exceed the single-number answer length. $^{\dagger }$MemoryLLM is the external persistent-memory reference and uses a different chat-tuned backbone, so its row is not a matched comparison.}}{16}{table.caption.42}\protected@file@percent }
\newlabel{tab:longeval}{{20}{16}{LongEval register-content accuracy. Unmarked rows use the unified chat-template-free protocol. Means use the common 8k--128k support. KV-Direct uses native RoPE without YaRN, so its 64k/128k cells are unextended stress references and the five-length mean is not a length-extended upper bound. CoMem's separate six-length headline is 72.83 after including its 4k score of 92. The frozen CoMem control used 48 generation tokens rather than 16; both budgets exceed the single-number answer length. $^{\dagger }$MemoryLLM is the external persistent-memory reference and uses a different chat-tuned backbone, so its row is not a matched comparison}{table.caption.42}{}}
\@writefile{lot}{\contentsline {table}{\numberline {21}{\ignorespaces BABILong accuracy ($n{=}100$ per task--length cell), evaluated with the official \texttt  {compare\_answers} scorer and \texttt  {TASK\_LABELS}. Within the native context window, full-context KV-Direct is substantially stronger on qa1 and qa2, exposing the compression tax, whereas distilled CoMem achieves the highest qa5 mean, ahead of InfLLM (68.7 vs.\ 64.9). All methods are evaluated under the unified plain-text prompting protocol, with model-specific chat templating disabled (\texttt  {chat\_template=False}). $^{\dagger }$MemoryLLM is the principal external persistent-memory reference and uses its released Llama-3-8B-chat checkpoint. Its different backbone precludes matched attribution. We retain the uniform no-chat row and make no prompt-sensitivity claim without a paper-retained matched table.}}{17}{table.caption.43}\protected@file@percent }
\newlabel{tab:babilong}{{21}{17}{BABILong accuracy ($n{=}100$ per task--length cell), evaluated with the official \texttt {compare\_answers} scorer and \texttt {TASK\_LABELS}. Within the native context window, full-context KV-Direct is substantially stronger on qa1 and qa2, exposing the compression tax, whereas distilled CoMem achieves the highest qa5 mean, ahead of InfLLM (68.7 vs.\ 64.9). All methods are evaluated under the unified plain-text prompting protocol, with model-specific chat templating disabled (\texttt {chat\_template=False}). $^{\dagger }$MemoryLLM is the principal external persistent-memory reference and uses its released Llama-3-8B-chat checkpoint. Its different backbone precludes matched attribution. We retain the uniform no-chat row and make no prompt-sensitivity claim without a paper-retained matched table}{table.caption.43}{}}
\def\@LN@column{2}
\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces Official LongBench QA token F1 by dataset. Except for the explicitly marked LLoCO diagnostic, methods use the same plain-text no-chat protocol. CoMem with LoRA scores 12.15 and full-context KV-Direct scores 12.17; because only CoMem uses the split-interface adapter, this near-equality is descriptive rather than a training-budget-matched compression estimate. The frozen CoMem configuration reports adapter-free performance at $j{=}9$. NQA denotes NarrativeQA, and MultiF. denotes MultiFieldQA-en. $^{\dagger }$MemoryLLM is the principal external persistent-memory reference and uses its released Llama-3-8B-chat checkpoint. Its different backbone precludes matched attribution. We retain the uniform no-chat row and make no prompt-sensitivity claim without a paper-retained matched table. $^{\ddagger }$LLoCO uses LLaMA-2-7B AutoCompressor, released per-domain supervised LoRAs, fp16, and its native task prompts. Released weights cover only NarrativeQA/Qasper/HotpotQA on our 200-example sets; 30.97 is their three-task macro and is not comparable to the six-task macro column.}}{17}{table.caption.44}\protected@file@percent }
\newlabel{tab:longbench}{{22}{17}{Official LongBench QA token F1 by dataset. Except for the explicitly marked LLoCO diagnostic, methods use the same plain-text no-chat protocol. CoMem with LoRA scores 12.15 and full-context KV-Direct scores 12.17; because only CoMem uses the split-interface adapter, this near-equality is descriptive rather than a training-budget-matched compression estimate. The frozen CoMem configuration reports adapter-free performance at $j{=}9$. NQA denotes NarrativeQA, and MultiF. denotes MultiFieldQA-en. $^{\dagger }$MemoryLLM is the principal external persistent-memory reference and uses its released Llama-3-8B-chat checkpoint. Its different backbone precludes matched attribution. We retain the uniform no-chat row and make no prompt-sensitivity claim without a paper-retained matched table. $^{\ddagger }$LLoCO uses LLaMA-2-7B AutoCompressor, released per-domain supervised LoRAs, fp16, and its native task prompts. Released weights cover only NarrativeQA/Qasper/HotpotQA on our 200-example sets; 30.97 is their three-task macro and is not comparable to the six-task macro column}{table.caption.44}{}}
