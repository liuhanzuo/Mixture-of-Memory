#!/bin/bash
# Experiment H14: Isolate Write Layer + Aggressive NIAH + Reduced cross_attn_lr
#
# Combines the best of H10 and H13:
#   - isolate_write_layer (from H13): prevents write-layer pollution
#   - aggressive NIAH (from H10): mix=0.50, lambda=2.0, warmup=100
#   - cross_attn_lr_factor=10 (reduced from 100): gentler cross-attn learning
#
# Hypothesis: H10 achieved ratio=1.05@600 WITHOUT isolate_write_layer.
# Adding isolation + reducing cross-attn lr should push ratio below 1.0.

set -e

# Detect ephemeral vs original cluster by checking CEPH share
if [ -d "/apdcephfs_wzc1/share_304376610" ]; then
    echo "Detected ephemeral cluster"
    CEPH_BASE="/apdcephfs_wzc1/share_304376610/pighzliu_code"
else
    echo "Detected original cluster"
    CEPH_BASE="/apdcephfs_wzc1/share_303098609/pighzliu_code"
fi

cd ${CEPH_BASE}/Mixture-of-Memory

export PYTHONPATH="${CEPH_BASE}/Mixture-of-Memory:$PYTHONPATH"
export PYTHONUNBUFFERED=1

LOGDIR=logs
mkdir -p $LOGDIR
LOGFILE=$LOGDIR/experiment_h14_isolate_aggressive_niah_$(date +%Y%m%d_%H%M).log

echo "============================================"
echo "Experiment H14: Isolate + Aggressive NIAH + Low cross_attn_lr"
echo "  isolate_write_layer + H10 NIAH params + cross_attn_lr_factor=10"
echo "Output: ${CEPH_BASE}/Mixture-of-Memory/outputs/experiment_h14_isolate_aggressive_niah"
echo "Log:    $LOGFILE"
echo "============================================"

torchrun \
    --nproc_per_node=8 \
    --nnodes=1 \
    --node_rank=0 \
    --rdzv_backend=c10d \
    --rdzv_endpoint=localhost:29500 \
    scripts/train_cross_attn_memory.py \
    --model ${CEPH_BASE}/models/Llama--Llama3-8b \
    --shard_dir ${CEPH_BASE}/data/dolmino-mix-1124-llama3 \
    --output_dir ${CEPH_BASE}/Mixture-of-Memory/outputs/experiment_h14_isolate_aggressive_niah \
    --wikitext_path ${CEPH_BASE}/Mixture-of-Memory/data/wikitext_chunks_llama3_4096.npy \
    --niah_data ${CEPH_BASE}/Mixture-of-Memory/data/pg19_chunks_llama3.npy \
    --slot_forward \
    --middle_layer_memory \
    --memory_write_layer 16 \
    --memory_read_layers 18,22,26,30 \
    --memory_init strided \
    --isolate_write_layer \
    --use_dual_gate \
    --forget_bias_init 1.0 \
    --input_bias_init 0.0 \
    --niah_mix_fraction 0.50 \
    --niah_max_N 2 \
    --niah_warmup_steps 100 \
    --lambda_retrieve 2.0 \
    --cross_attn_lr_factor 10 \
    --num_shards 25 \
    --seq_len 4096 \
    --chunks_per_doc 32 \
    --num_slots 64 \
    --full_finetune \
    --use_memory \
    --gradient_checkpointing \
    --gradient_accumulation_steps 4 \
    --lr 5e-6 \
    --min_lr 1e-6 \
    --warmup_steps 200 \
    --max_steps 5000 \
    --eval_interval 200 \
    --save_interval 500 \
    --weight_decay 0.01 \
    --max_grad_norm 1.0 \
    2>&1 | tee $LOGFILE
